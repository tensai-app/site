---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import Shot from "../components/Shot.astro";
import { home } from "../i18n/pages/home";
import { LLAMA_KT_REPO } from "../i18n/site";
import { localizePath, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = home[locale];
---

<BaseLayout title={c.title} description={c.description}>
  <div class="container">
    <section class="hero">
      <div class="hero-text">
        <div class="mark-wrap">
          <span class="halo" aria-hidden="true"></span>
          <span class="mark-icon" role="img" aria-label={c.hero.markLabel}><Mark size={176} /></span>
        </div>
        <h1>{c.hero.heading}</h1>
        <p class="sub">{c.hero.sub}</p>
        <div class="actions">
          <div class="cta">
            <button class="btn btn-filled btn-lg" type="button" disabled aria-describedby="dl-note">
              <Icon name="download" size={19} />
              {c.hero.cta}
            </button>
            <p class="note" id="dl-note">
              <Icon name="clock" size={14} />
              <span>{c.hero.ctaNote}</span>
            </p>
          </div>
          <a class="text-link" href="#how">
            {c.hero.how}
            <Icon name="arrow_right" size={18} />
          </a>
        </div>
        <p class="engine"><a href={localizePath("/llama-kt/", locale)}>{c.hero.engine}</a></p>
      </div>
      <div class="hero-shot">
        <Shot name="hero" alt={c.hero.shotAlt} sizes="(min-width: 60rem) 351px, 312px" priority />
      </div>
    </section>

    <section class="section pillars" id="how" aria-label={c.hero.how}>
      {
        c.pillars.map((p) => (
          <div class="card pillar">
            <span class="pillar-icon">
              <Icon name={p.icon as "smartphone" | "deployed_code" | "verified_user"} size={28} />
            </span>
            <h2>{p.title}</h2>
            <p>{p.text}</p>
            {p.fit && (
              <ul class="fit-legend" aria-label={c.fit.label}>
                <li><span class="dot dot-success" aria-hidden="true"></span>{c.fit.ok}</li>
                <li><span class="dot dot-warning" aria-hidden="true"></span>{c.fit.tight}</li>
                <li><span class="dot dot-error" aria-hidden="true"></span>{c.fit.no}</li>
              </ul>
            )}
          </div>
        ))
      }
    </section>

    <section class="section" aria-labelledby="shots-h">
      <h2 class="big" id="shots-h">{c.shots.heading}</h2>
      <ul class="strip">
        {
          c.shots.items.map((s) => (
            <li>
              <figure>
                <div class="shot-frame">
                  <Shot name={s.key} alt={s.alt} sizes="(min-width: 60rem) 273px, 242px" />
                </div>
                <figcaption>{s.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section numbers" aria-labelledby="numbers-h">
      <div class="numbers-text">
        <h2 class="big" id="numbers-h">{c.numbers.heading}</h2>
        <p>{c.numbers.text}</p>
      </div>
      <div>
        <div class="card table-card">
          <p class="setup mono">{c.numbers.setup}</p>
          <table>
            <tbody>
              {
                c.numbers.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    <td class:list={{ accent: r.accent }}>{r.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="footnote">{c.numbers.note}</p>
      </div>
    </section>

    <section class="section" aria-labelledby="next-h">
      <h2 class="muted-h" id="next-h">{c.next.heading}</h2>
      <ul class="timeline">
        {c.next.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="card band">
        <p>{c.band.text}</p>
        <div class="band-actions">
          <a class="btn btn-filled" href={LLAMA_KT_REPO}>
            {c.band.github}
            <Icon name="arrow_up_right" size={19} />
          </a>
          {isLive("/docs/") && <a class="btn btn-outlined" href={localizePath("/docs/", locale)}>{c.band.docs}</a>}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-block: 3.5rem 4rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mark-wrap {
    position: relative;
    width: 176px;
    height: 168px;
    color: var(--primary);
  }

  .halo {
    position: absolute;
    inset: -90px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--primary-16) 0%, transparent 62%);
  }

  .mark-icon {
    position: absolute;
    inset: 0;
  }

  .mark-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  h1 {
    margin: 2.5rem 0 0;
    font-size: clamp(2.75rem, 9vw, 4.75rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .sub {
    max-width: 38.75rem;
    margin: 1.5rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 2.4vw, 1.25rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 1.75rem;
    margin-top: 2.5rem;
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .btn-lg {
    min-height: 3.25rem;
    padding-inline: 1.75rem;
  }

  .note {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding-inline-start: 0.25rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .actions .text-link {
    min-height: 3.25rem;
  }

  .engine {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }

  .hero-shot {
    width: 19.5rem;
    max-width: 100%;
    margin-inline: auto;
  }

  .pillars {
    display: grid;
    gap: 1.5rem;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2.25rem 2rem;
  }

  .pillar-icon {
    display: inline-flex;
    color: var(--primary);
  }

  .pillar h2 {
    margin: 0.5rem 0 0;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .pillar p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .pillar .fit-legend {
    margin-top: 0.25rem;
  }

  .big {
    margin: 0 0 2rem;
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 15.125rem;
    gap: 1.5rem;
    margin: 0;
    padding: 0 0 1rem;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
  }

  .strip li {
    scroll-snap-align: start;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
  }

  figcaption {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .numbers {
    display: grid;
    gap: 2rem;
  }

  .numbers-text h2 {
    margin-bottom: 1.25rem;
  }

  .numbers-text p {
    max-width: 28.75rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .table-card {
    overflow: hidden;
  }

  .setup {
    margin: 0;
    padding: 1.125rem 1.75rem;
    border-bottom: 1px solid var(--outline);
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
  }

  tr + tr {
    border-top: 1px solid var(--outline);
  }

  th {
    padding: 1.25rem 1.75rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 400;
    text-align: start;
  }

  td {
    padding: 1.25rem 1.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    text-align: end;
    white-space: nowrap;
  }

  td.accent {
    color: var(--primary);
  }

  .footnote {
    margin: 0.875rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .muted-h {
    margin: 0 0 2.5rem;
    color: var(--text-secondary);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .timeline {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .timeline li {
    position: relative;
    padding-block: 1.5rem 1rem;
    color: var(--text-secondary);
    font-size: 1.1875rem;
    font-weight: 500;
  }

  .timeline li::before {
    content: "";
    position: absolute;
    top: -0.375rem;
    inset-inline-start: 0;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 1.5px solid var(--text-secondary);
    border-radius: 50%;
    background: var(--background);
  }

  .band {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.75rem, 5vw, 3.5rem) clamp(1.5rem, 5vw, 4rem);
  }

  .band p {
    max-width: 38.75rem;
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 351px;
      align-items: center;
      gap: 6rem;
      padding-block: 6rem 7.5rem;
    }

    .hero-shot {
      width: 100%;
      margin: 0;
    }

    h1 {
      font-size: clamp(2.75rem, 5.3vw, 4.75rem);
    }

    .strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      padding: 0;
    }

    .numbers {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 6rem;
      align-items: start;
    }

    .band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }

    .band-actions {
      flex: none;
    }
  }

  @media (max-width: 39.99rem) {
    .hero-text,
    .actions,
    .cta {
      align-items: stretch;
    }

    .actions {
      flex-direction: column;
      gap: 0.25rem;
    }

    .note {
      justify-content: center;
      padding-inline-start: 0;
    }

    .actions .text-link {
      justify-content: center;
      min-height: 3rem;
    }

    .engine {
      align-self: flex-start;
    }

    .strip {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }

    .band-actions .btn {
      flex: 1 1 100%;
    }

    .setup {
      padding-inline: 1.25rem;
    }

    th,
    td {
      padding-inline: 1.25rem;
    }

    td {
      font-size: 1.125rem;
    }
  }
</style>
