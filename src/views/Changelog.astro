---
import BaseLayout from "../layouts/BaseLayout.astro";
import { changelog } from "../i18n/pages/changelog";
import { releases, anchor } from "../data/changelog";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = changelog[locale];
const fmt = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const date = (iso: string) => fmt.format(new Date(`${iso}T00:00:00Z`));
---

<BaseLayout title={c.title} description={c.description}>
  <link slot="head" rel="alternate" type="application/atom+xml" title={`tensai ${c.heading}`} href="/changelog.xml" />
  <div class="container page">
    <header class="head">
      <div>
        <h1>{c.heading}</h1>
        <p class="lead">{c.lead}</p>
        {c.note && <p class="note">{c.note}</p>}
      </div>
      <a class="text-link feed" href="/changelog.xml">{c.atom}</a>
    </header>

    <div class="layout">
      <nav class="versions" aria-label={c.versionsLabel}>
        <ol>
          {
            releases.map((r, i) => (
              <li>
                <a class="mono" href={`#${anchor(r.version)}`} aria-current={i === 0 ? "location" : undefined}>{r.version}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="releases">
        {
          releases.map((r, i) => (
            <section class="release" id={anchor(r.version)} aria-labelledby={`${anchor(r.version)}-v`}>
              <h2>
                <span class="version mono" id={`${anchor(r.version)}-v`}>{r.version}</span>
                <a class="anchor" href={`#${anchor(r.version)}`} aria-label={`${c.anchorLabel} ${r.version}`}>#</a>
                {i === 0 && <span class="chip" lang={locale}>{c.latest}</span>}
              </h2>
              <p class="date mono"><time datetime={r.date}>{date(r.date)}</time></p>
              {r.title && <p class="title" lang="en">{r.title}</p>}
              <p class="intro" lang="en">{r.intro}</p>
              {
                r.groups.map((g) => (
                  <>
                    <h3 lang="en">{g.label}</h3>
                    <ul lang="en">
                      {g.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </>
                ))
              }
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/changelog-spy";
</script>

<style>
  .page {
    padding-block: 3rem 5rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  .lead,
  .note {
    max-width: 68ch;
    margin: 0 0 0.5rem;
    color: var(--text-secondary);
  }

  .feed {
    flex: none;
  }

  .versions {
    display: none;
  }

  .releases {
    max-width: 68ch;
  }

  .release {
    padding-block: 2rem;
    border-top: 1px solid var(--outline);
    scroll-margin-top: 1rem;
  }

  .release:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .release h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .version {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .anchor {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.7;
  }

  .anchor:hover,
  .anchor:focus-visible {
    background: var(--primary-12);
    opacity: 1;
  }

  .chip {
    padding: 0.1rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--primary-16);
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .date {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .title {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .intro {
    color: var(--text-secondary);
  }

  .release h3 {
    margin: 1.5rem 0 0.5rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .release ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  .release li {
    margin-bottom: 0.5rem;
  }

  @media (min-width: 40rem) {
    .page {
      padding-block: 96px 128px;
    }
  }

  @media (min-width: 64rem) {
    .layout {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    /* Rail and dots share one x: --rail-x from the list start, everything centred on it. The nav scrolls on its own
       when the list is taller than the viewport; its padding keeps the dots and focus rings inside the clip. */
    .versions {
      --rail-x: 0px;
      display: block;
      position: sticky;
      top: 2rem;
      max-height: calc(100dvh - 4rem);
      margin-inline-start: -0.75rem;
      padding-inline-start: 0.75rem;
      overflow-y: auto;
    }

    .versions ol {
      position: relative;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .versions ol::before {
      content: "";
      position: absolute;
      inset-block: 0;
      left: var(--rail-x);
      width: 2px;
      background: var(--outline-strong);
      transform: translateX(-50%);
    }

    .versions li {
      position: relative;
      padding-inline-start: 1.5rem;
    }

    .versions li::before {
      content: "";
      position: absolute;
      left: var(--rail-x);
      top: 50%;
      width: 10px;
      height: 10px;
      border: 2px solid var(--outline-strong);
      border-radius: 50%;
      background: var(--background);
      box-sizing: border-box;
      transform: translate(-50%, -50%);
    }

    .versions li:has(a[aria-current])::before {
      transform: translate(-50%, -50%) scale(1.4);
      border-color: var(--primary);
      background: var(--primary);
    }

    .versions a {
      display: block;
      padding-block: 0.4rem;
      color: var(--text-secondary);
      text-decoration: none;
    }

    .versions a:hover {
      color: var(--text);
    }

    .versions a[aria-current] {
      color: var(--primary);
      font-weight: 600;
    }
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .versions li::before,
    .versions a {
      transition: background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
    }
  }
</style>
