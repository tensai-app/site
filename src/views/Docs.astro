---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Inline from "../components/Inline.astro";
import DocsNav from "../components/DocsNav.astro";
import Shot from "../components/Shot.astro";
import PrereleaseBanner from "../components/PrereleaseBanner.astro";
import { docs, nav, order, routes, type Block, type Slug } from "../i18n/pages/docs";
import { home } from "../i18n/pages/home";
import { llamakt } from "../i18n/pages/llamakt";
import { privacy } from "../i18n/pages/privacy";
import { docsFit } from "../data/fit";
import { measuredRows } from "../data/measured";
import { DOCS_EDIT_LINK, DOCS_SOURCE, LAUNCHED } from "../i18n/site";
import { localizePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  slug: Slug;
}
const { locale, slug } = Astro.props;
const c = docs[locale];
const a = c.articles[slug];
const ch = c.chrome;
const isFaq = slug === "faq";

const group = nav.find((e) => "group" in e && e.items.includes(slug));
const groupLabel = group && "group" in group ? ch.groups[group.group as "start" | "models"] : undefined;

// "On this page": the h2 of each section and the h3 blocks inside them. The FAQ has none, its questions are the page.
const toc = isFaq
  ? []
  : a.sections.flatMap((s) => [
      { id: s.id, text: s.h, level: 2 },
      ...s.blocks.flatMap((b) => (b.t === "h3" ? [{ id: b.id, text: b.x, level: 3 }] : [])),
    ]);

// Previous and next in reading order. "privacy" is the existing privacy page.
const entry = (s: Slug | "privacy") => ({
  label: s === "privacy" ? privacy[locale].heading : c.articles[s].title,
  href: localizePath(s === "privacy" ? "/privacy/" : routes[s], locale),
});
const at = order.indexOf(slug);
const prev = at > 0 ? entry(order[at - 1]!) : undefined;
const next = at < order.length - 1 ? entry(order[at + 1]!) : undefined;

const num = (n: string) => (locale === "fr" ? n.replace(".", ",") : n);
const gb = (n: number) => `${n.toFixed(2).replace(".", locale === "fr" ? "," : ".")} ${ch.fit.unit}`;
const rowName = (m: (typeof docsFit.models)[number]) => (m.cls ? ch.fit.classModel.replace("{n}", m.cls) : m.label);
const classRow = docsFit.models.find((m) => m.cls);
const dots = ["dot-success", "dot-warning", "dot-error"];
const llamaSetup = llamakt[locale].measured.setup;
const numbers = home[locale].numbers;

const hasCode = a.sections.some((s) => s.blocks.some((b) => b.t === "code"));
const parts = (b: Extract<Block, { t: "code" }>) => (b.accent ? b.text.split(b.accent) : [b.text]);
---

<BaseLayout title={`${a.title} · tensai`} description={a.description}>
  {
    !LAUNCHED && (
      <div class="banner-row">
        <PrereleaseBanner locale={locale} />
      </div>
    )
  }
  <div class="menu-bar">
    <details class="menu-m">
      <summary>
        <span class="visually-hidden">{ch.menu}: </span>
        <span class="crumb-m">
          {groupLabel && <span class="grp">{groupLabel}</span>}
          {groupLabel && <span class="grp" aria-hidden="true">/</span>}
          <span class="here">{a.title}</span>
        </span>
        <Icon name="expand_more" size={20} />
        <Icon name="expand_less" size={20} />
      </summary>
      <nav class="panel" aria-label={ch.menu}>
        <DocsNav locale={locale} slug={slug} />
      </nav>
    </details>
  </div>

  <div class="docs-wrap">

    <div class="layout" data-rail={toc.length ? "" : undefined}>
      <aside class="side">
        <nav aria-label={ch.sectionsLabel}>
          <DocsNav locale={locale} slug={slug} />
        </nav>
      </aside>

      <article class="article">
        <p class="crumb">
          <span>{ch.docs}</span>
          <span aria-hidden="true">/</span>
          <span>{groupLabel ?? a.title}</span>
        </p>
        <h1>{a.title}</h1>
        <p class:list={["lead", { "faq-lead": isFaq }]}>{a.lead}</p>

        {
          a.sections.map((s) => (
            <section aria-labelledby={isFaq ? undefined : s.id} aria-label={isFaq ? a.title : undefined}>
              {!isFaq && <h2 id={s.id}>{s.h}</h2>}
              {s.blocks.map((b) => {
                if (b.t === "p") return <p><Inline text={b.x} locale={locale} /></p>;
                if (b.t === "ul") return <ul>{b.items.map((i) => <li><Inline text={i} locale={locale} /></li>)}</ul>;
                if (b.t === "ol") return <ol>{b.items.map((i) => <li><Inline text={i} locale={locale} /></li>)}</ol>;
                if (b.t === "h3") return <h3 id={b.id}>{b.x}</h3>;
                if (b.t === "note")
                  return (
                    <aside class="note">
                      <Icon name="info" size={20} />
                      <div>
                        <p class="note-title">{b.title}</p>
                        <p><Inline text={b.x} locale={locale} /></p>
                      </div>
                    </aside>
                  );
                if (b.t === "dl")
                  return (
                    <dl class:list={{ terms: b.mono }}>
                      {b.items.map(([k, v]) => (
                        <>
                          <dt>{k}</dt>
                          <dd><Inline text={v} locale={locale} /></dd>
                        </>
                      ))}
                    </dl>
                  );
                if (b.t === "code")
                  return (
                    <div class="code">
                      <div class="code-bar">
                        <span class="mono code-label">{b.label}</span>
                        <button class="copy" type="button" data-copy data-copy-value={b.text} data-done={ch.copied} data-failed={ch.copyFailed} hidden>
                          <Icon name="content_copy" size={22} class="ic-copy" />
                          <Icon name="check" size={22} class="ic-check" />
                          <span class="visually-hidden">{ch.copy}: {b.label}</span>
                        </button>
                      </div>
                      <pre tabindex="0" role="region" aria-label={b.label}><code>{parts(b).map((p, i) => (i === 0 ? p : <><span class="accent">{b.accent}</span>{p}</>))}</code></pre>
                    </div>
                  );
                if (b.t === "fit")
                  return (
                    <>
                    <div class="card scroll" role="region" aria-label={ch.fit.region} tabindex="0">
                      <table>
                        <caption class="visually-hidden">{ch.fit.region}</caption>
                        <thead>
                          <tr>
                            <th scope="col">{ch.fit.model}</th>
                            <th scope="col"><span class="long">{ch.fit.file}</span><span class="short">{ch.fit.fileShort}</span></th>
                            {docsFit.rams.map((r) => <th scope="col"><span class="mono">{r} {ch.fit.unit}</span><span class="long"> RAM</span></th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {docsFit.models.map((m) => (
                            <tr>
                              <th scope="row">{rowName(m)}</th>
                              <td class="mono muted nowrap">{gb(m.file)}</td>
                              {m.verdicts.map((v) => (
                                <td><span class="verdict"><span class={`dot ${dots[v]}`} aria-hidden="true" />{ch.fit.labels[v]}</span></td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    {classRow?.cls && <p class="small">{ch.fit.classNote.replace("{n}", classRow.cls)}</p>}
                    </>
                  );
                if (b.t === "measured")
                  return (
                    <>
                      <p class="setup mono">{llamaSetup}</p>
                      <div class="card scroll" role="region" aria-label={ch.measured.caption} tabindex="0">
                        <table>
                          <caption class="visually-hidden">{ch.measured.caption}</caption>
                          <thead>
                            <tr>
                              <th scope="col">{ch.measured.model}</th>
                              <th scope="col">{ch.measured.backend}</th>
                              <th scope="col" class="num">{ch.measured.pp}</th>
                              <th scope="col" class="num">{ch.measured.tg}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {measuredRows.map(([model, quant, backends]) =>
                              backends.map(([backend, pp, tg, fast], i) => (
                                <tr class:list={{ first: i === 0 }}>
                                  {i === 0 && <th scope="row" rowspan={backends.length}>{model} <span class="mono muted">{quant}</span></th>}
                                  <td class:list={{ win: fast }}>
                                    {backend}
                                    {fast && (
                                      <>
                                        <span class="dot dot-success" aria-hidden="true" />
                                        <span class="visually-hidden">({ch.measured.faster})</span>
                                      </>
                                    )}
                                  </td>
                                  <td class="num mono">{num(pp)}</td>
                                  <td class:list={["num mono", { win: fast }]}>{num(tg)}</td>
                                </tr>
                              )),
                            )}
                          </tbody>
                        </table>
                      </div>
                    </>
                  );
                if (b.t === "numbers")
                  return (
                    <>
                      <p class="setup mono">{numbers.setup}</p>
                      <dl class="stats">
                        {numbers.rows.map((r) => (
                          <div class="stat card">
                            <dt>{r.label}</dt>
                            <dd class="mono">{r.value}</dd>
                          </div>
                        ))}
                      </dl>
                      <p class="small">{numbers.note}</p>
                    </>
                  );
                if (b.t === "shot")
                  return (
                    <figure>
                      <div class="fig-img">
                        <Shot name={b.name} alt={b.alt} sizes="(min-width: 40rem) 254px, 220px" />
                      </div>
                      <figcaption>{b.caption}</figcaption>
                    </figure>
                  );
                if (b.t === "faq")
                  return (
                    <div class="faq">
                      {b.items.map((i, n) => (
                        <details open={n === 0}>
                          <summary>
                            <h2>{i.q}</h2>
                            <Icon name="expand_more" size={22} />
                            <Icon name="expand_less" size={22} />
                          </summary>
                          <p><Inline text={i.a} locale={locale} /></p>
                        </details>
                      ))}
                    </div>
                  );
                return null;
              })}
            </section>
          ))
        }

        {hasCode && <span class="visually-hidden" role="status" aria-live="polite" data-copy-status />}

        <footer class="pager">
          <div class="pager-links">
            {
              prev && (
                <a class="pager-link" href={prev.href} rel="prev">
                  <span class="dir"><Icon name="arrow_back" size={14} />{ch.previous}</span>
                  <span class="name">{prev.label}</span>
                </a>
              )
            }
            {
              next && (
                <a class="pager-link end" href={next.href} rel="next">
                  <span class="dir">{ch.next}<Icon name="arrow_right" size={14} /></span>
                  <span class="name">{next.label}</span>
                </a>
              )
            }
          </div>
          {DOCS_EDIT_LINK && <a class="edit" href={DOCS_SOURCE}>{ch.edit}</a>}
        </footer>
      </article>

      {
        toc.length > 0 && (
          <aside class="rail">
            <nav aria-label={ch.onThisPage}>
              <p class="rail-title mono">{ch.onThisPage}</p>
              <ul>
                {toc.map((t, i) => (
                  <li>
                    <a class:list={{ sub: t.level === 3 }} href={`#${t.id}`} aria-current={i === 0 ? "location" : undefined}>{t.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

{hasCode && <script>import "../scripts/copy";</script>}
{toc.length > 0 && <script>import "../scripts/docs-spy";</script>}

<style>
  /* Metrics are the Claude Design "Docs" artboards: mobile (390) below 40rem, desktop (1440) from there. */
  .banner-row,
  .docs-wrap {
    --pad: 20px;
    width: 100%;
    max-width: calc(1280px + 2 * var(--pad));
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .banner-row {
    padding-top: 16px;
  }

  .docs-wrap {
    padding-block: 36px 72px;
  }

  /* Mobile: the section menu replaces the sidebar. A bar under the banner, a pill button, the list inline. */
  .menu-bar {
    margin-top: 16px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--outline);
  }

  .menu-m summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid var(--outline-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }

  .menu-m summary::-webkit-details-marker {
    display: none;
  }

  .menu-m summary :global(svg) {
    flex: none;
  }

  .menu-m summary :global(svg:last-child),
  .menu-m[open] summary :global(svg:nth-last-child(2)) {
    display: none;
  }

  .menu-m[open] summary :global(svg:last-child) {
    display: block;
  }

  .crumb-m {
    display: flex;
    gap: 6px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .crumb-m .grp {
    color: var(--text-secondary);
  }

  .crumb-m .here {
    font-weight: 600;
  }

  .panel {
    padding: 12px 0 4px;
  }

  .side,
  .rail {
    display: none;
  }

  .article {
    max-width: 700px;
    min-width: 0;
  }

  .crumb {
    display: flex;
    gap: 8px;
    margin: 0 0 16px;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  h1 {
    margin: 0;
    font-size: 2.125rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .lead {
    margin: 16px 0 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .lead.faq-lead {
    margin-bottom: 28px;
  }

  section > h2 {
    margin: 44px 0 12px;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    scroll-margin-top: 1.5rem;
  }

  h3 {
    margin: 28px 0 10px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    scroll-margin-top: 1.5rem;
  }

  p,
  li {
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  p {
    margin: 0 0 16px;
  }

  ul,
  ol {
    margin: 0 0 1rem;
    padding-inline-start: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  code {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface-variant);
    font-size: 13.5px;
  }

  .note {
    display: flex;
    gap: 14px;
    margin: 28px 0;
    padding: 18px;
    border-left: 3px solid var(--primary);
    border-radius: 0 16px 16px 0;
    background: var(--surface-variant);
  }

  .note :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--primary);
  }

  .note > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .note p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .note .note-title {
    color: var(--text);
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.65;
  }

  /* Definition lists. The mono ones ("Reading the name") are the mockup's: no rules, a fixed term column. */
  dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 0 1.25rem;
    border-top: 1px solid var(--outline);
  }

  dt {
    padding-top: 0.875rem;
    font-size: 0.96875rem;
    font-weight: 600;
  }

  dd {
    margin: 0;
    padding-block: 0.15rem 0.875rem;
    border-bottom: 1px solid var(--outline);
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.55;
  }

  dl.terms {
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 10px 16px;
    margin: 0 0 8px;
    border-top: 0;
    font-size: 15.5px;
    line-height: 1.5;
  }

  dl.terms dt {
    padding: 0;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  dl.terms dd {
    padding: 0;
    border: 0;
    font-size: inherit;
  }

  .code {
    margin: 20px 0 8px;
    overflow: hidden;
    border: 1px solid var(--outline);
    border-radius: 16px;
    background: var(--surface);
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px 4px 18px;
    border-bottom: 1px solid var(--outline);
  }

  .code-label {
    color: var(--text-secondary);
    font-size: 12.5px;
  }

  .copy {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .copy[hidden] {
    display: none;
  }

  .copy:hover {
    background: var(--primary-08);
  }

  pre {
    margin: 0;
    padding: 16px 18px;
    overflow-x: auto;
  }

  pre code {
    padding: 0;
    background: none;
    font-size: 14px;
  }

  .accent {
    color: var(--primary);
  }

  .card {
    border: 1px solid var(--outline);
    border-radius: 16px;
    background: var(--surface);
  }

  .scroll {
    margin: 20px 0 8px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  thead th {
    padding: 12px 10px;
    border-bottom: 1px solid var(--outline);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    text-align: start;
    white-space: nowrap;
  }

  thead th .mono {
    font-weight: 400;
  }

  tbody th,
  tbody td {
    padding: 14px 10px;
    font-weight: 400;
    text-align: start;
    vertical-align: top;
  }

  tbody th {
    font-weight: 600;
  }

  tbody tr + tr th,
  tbody tr + tr td {
    border-top: 1px solid var(--outline);
  }

  tbody tr.first:not(:first-child) th,
  tbody tr.first:not(:first-child) td {
    border-top: 1px solid var(--outline);
  }

  tbody tr:not(.first) th,
  tbody tr:not(.first) td {
    border-top: 0;
  }

  .muted {
    color: var(--text-secondary);
    font-size: 12.5px;
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Mobile: the dot sits above the label. */
  .verdict {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    white-space: nowrap;
  }

  .short {
    display: inline;
  }

  .long {
    display: none;
  }

  .num {
    text-align: end;
  }

  thead th.num {
    font-family: var(--font-sans);
  }

  td.win {
    font-weight: 700;
  }

  td.win .dot {
    margin-inline-start: 0.5rem;
    vertical-align: middle;
  }

  .setup {
    margin: 1rem 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    border-top: 0;
  }

  .stat {
    padding: 1rem 1.25rem;
  }

  .stat dt {
    padding: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .stat dd {
    padding: 0.25rem 0 0;
    border: 0;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .small {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 24px 0 8px;
  }

  .fig-img {
    flex: none;
    width: 234px;
  }

  figcaption {
    max-width: 300px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.55;
    text-align: center;
    text-wrap: pretty;
  }

  /* FAQ: one surface card, rows separated by a rule. */
  .faq {
    overflow: hidden;
    border: 1px solid var(--outline);
    border-radius: 20px;
    background: var(--surface);
  }

  .faq details + details {
    border-top: 1px solid var(--outline);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 14px 16px 14px 20px;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary h2 {
    margin: 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.5;
  }

  .faq summary :global(svg) {
    flex: none;
    color: var(--text-secondary);
  }

  .faq summary :global(svg:last-child),
  .faq details[open] summary :global(svg:nth-last-child(2)) {
    display: none;
  }

  .faq details[open] summary :global(svg:last-child) {
    display: block;
  }

  .faq details p {
    margin: 0;
    padding: 0 20px 20px;
    color: var(--text-secondary);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .pager {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--outline);
  }

  .pager-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--outline);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .pager-link:hover {
    background: var(--primary-08);
  }

  .dir {
    display: flex;
    align-items: center;
    gap: 4px;
