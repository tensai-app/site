---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import { useT, localizePath, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale).notFound;
---

<BaseLayout title={t.title} description={t.description} noindex bare>
  <div class="container page">
    <span class="mark" aria-hidden="true"><Mark size={520} /></span>
    <p class="code mono">404</p>
    <h1>{t.heading}</h1>
    <div class="actions">
      <a class="btn btn-filled" href={localizePath("/", locale)}>
        <Icon name="arrow_back" size={18} />
        {t.back}
      </a>
      {isLive("/docs/") && <a class="text-link" href={localizePath("/docs/", locale)}>{t.docs}</a>}
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100dvh - 4rem - 1px);
    padding-block: 4rem;
    text-align: center;
    isolation: isolate;
  }

  .mark {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: -1;
    display: flex;
    color: var(--primary);
    opacity: 0.07;
    transform: translate(-50%, -50%);
  }

  .mark :global(svg) {
    width: 300px;
    height: 286px;
  }

  .code {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }

  h1 {
    margin-bottom: 2rem;
    font-size: 1.875rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
  }

  @media (min-width: 40rem) {
    .mark :global(svg) {
      width: 520px;
      height: 495px;
    }

    h1 {
      font-size: 2.75rem;
    }

    .actions {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.5rem 1.5rem;
      width: auto;
    }
  }
</style>
