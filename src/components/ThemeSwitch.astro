---
import Icon from "./Icon.astro";
import { useT, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale).theme;
const options = [
  { value: "system", label: t.system, icon: "auto" },
  { value: "dark", label: t.dark, icon: "moon" },
  { value: "light", label: t.light, icon: "sun" },
] as const;
---

<div class="theme-switch" role="radiogroup" aria-label={t.label} data-theme-switch hidden>
  {
    options.map((o) => (
      <label>
        <input type="radio" name="theme" value={o.value} checked={o.value === "system"} />
        <span class="opt" title={o.label}>
          <Icon name={o.icon} size={18} />
          <span class="visually-hidden">{o.label}</span>
        </span>
      </label>
    ))
  }
</div>

<script>
  import "../scripts/theme";
</script>

<style>
  .theme-switch {
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    border-radius: var(--radius-pill);
    background: var(--surface-variant);
  }

  .theme-switch[hidden] {
    display: none;
  }

  label {
    position: relative;
    display: block;
  }

  input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
  }

  .opt {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .opt:hover {
    color: var(--text);
  }

  input:checked + .opt {
    background: var(--primary);
    color: var(--on-primary);
  }

  input:focus-visible + .opt {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }

  /* Narrow: 44px touch targets, no padding or gap, so the three options take 132px. */
  @media (max-width: 44.99rem) {
    .theme-switch {
      gap: 0;
      padding: 0;
    }

    .opt {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
