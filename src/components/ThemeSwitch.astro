---
import Icon from "./Icon.astro";
import { useT, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** "bar": icons only, in the desktop header. "sheet": full width with labels, in the mobile menu. */
  variant?: "bar" | "sheet";
}
const { locale, variant = "bar" } = Astro.props;
const t = useT(locale).theme;
const options = [
  { value: "system", label: t.system, icon: "auto" },
  { value: "dark", label: t.dark, icon: "moon" },
  { value: "light", label: t.light, icon: "sun" },
] as const;
---

<div class:list={["theme-switch", variant]} role="radiogroup" aria-label={t.label} data-theme-switch hidden={variant === "sheet"} data-pending={variant === "bar" ? "" : undefined}>
  {
    options.map((o) => (
      <label>
        <input type="radio" name={`theme-${variant}`} value={o.value} checked={o.value === "system"} />
        <span class="opt" title={variant === "bar" ? o.label : undefined}>
          <Icon name={o.icon} size={18} />
          <span class:list={{ "visually-hidden": variant === "bar" }}>{o.label}</span>
        </span>
      </label>
    ))
  }
</div>

<script>
  import "../scripts/theme";
</script>

<style>
  /* Same outer box as the language switch: 1px border + 3px padding + 38px segments (44px in the sheet). */
  .theme-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--outline-strong);
    border-radius: var(--radius-pill);
  }

  /* The bar variant keeps its box before the script runs, so nothing around it moves. */
  .theme-switch[data-pending] {
    visibility: hidden;
  }

  .theme-switch[hidden] {
    display: none;
  }

  .theme-switch.sheet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .theme-switch.sheet[hidden] {
    display: none;
  }

  label {
    position: relative;
    display: block;
  }

  input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
  }

  .opt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-sizing: border-box;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .sheet .opt {
    width: 100%;
    height: 44px;
    font-size: 14px;
    font-weight: 600;
  }

  .opt:hover {
    color: var(--text);
  }

  input:checked + .opt {
    background: var(--primary);
    color: var(--on-primary);
  }

  input:focus-visible + .opt {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }
</style>
