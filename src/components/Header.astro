---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { useT, localizePath, stripLocale, locales, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const langNames: Record<Locale, string> = { en: "English", fr: "Français" };
const path = stripLocale(Astro.url.pathname);
const switchPath = /^\/404\/?$/.test(path) ? "/" : path;

const links = [
  { path: "/download/", href: localizePath("/download/", locale), label: t.nav.download },
  { path: "/docs/", href: localizePath("/docs/", locale), label: t.nav.docs },
  { path: "/changelog/", href: localizePath("/changelog/", locale), label: t.nav.changelog },
  { path: "/llama-kt/", href: localizePath("/llama-kt/", locale), label: t.nav.llamaKt },
].filter((l) => isLive(l.path));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath("/", locale)}>
      <Mark size={30} />
      <span class="wordmark">{t.siteName}</span>
    </a>

    <details class="menu">
      <summary aria-label={t.nav.menu}>
        <Icon name="menu" size={24} />
      </summary>
      <nav aria-label={t.nav.label}>
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={path === l.path ? "page" : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>

    <div class="tools">
      <a class="icon-link" href="https://github.com/tensai-app" aria-label={t.nav.github}>
        <Icon name="github" size={22} />
      </a>
      <ThemeSwitch locale={locale} />
      <div class="lang" role="group" aria-label={t.lang.label}>
        <Icon name="globe" size={18} />
        {
          locales.map((l) =>
            l === locale ? (
              <span class="lang-item current" aria-current="true" lang={l}>
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
              </span>
            ) : (
              <a class="lang-item" href={localizePath(switchPath, l)} hreflang={l} lang={l}>
                <span aria-hidden="true">{l.toUpperCase()}</span>
                <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
              </a>
            ),
          )
        }
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: auto;
    padding-block: 0.5rem;
    color: var(--primary);
    text-decoration: none;
  }

  .wordmark {
    color: var(--text);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .menu {
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary:hover {
    background: var(--surface-variant);
  }

  .menu nav {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 13rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    color: var(--primary);
  }

  nav a:hover {
    background: var(--surface-variant);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  /* Narrow: the tools always get their own row. Left to wrap on their own, they fit on the brand row
     with the fallback font and wrap once the web font is in, which shifts the whole page. */
  @media (max-width: 32rem) {
    .tools {
      flex-basis: 100%;
    }
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    text-decoration: none;
  }

  .icon-link:hover,
  a.lang-item:hover {
    background: var(--surface-variant);
  }

  /* EN / FR: both shown, the current one is emphasised and is not a link. */
  .lang {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
  }

  .lang :global(svg) {
    display: none;
  }

  .lang-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .lang-item.current {
    color: var(--text);
    font-weight: 700;
  }

  @media (min-width: 40rem) {
    .lang :global(svg) {
      display: block;
      margin-inline-end: 0.15rem;
    }
  }

  /* Wide screens: the nav is laid out inline. Without ::details-content support the
     summary stays and the menu keeps working as a toggle. */
  @media (min-width: 52rem) {
    @supports selector(::details-content) {
      .menu {
        margin-inline-end: 0.75rem;
      }

      .menu summary {
        display: none;
      }

      .menu::details-content {
        content-visibility: visible;
        display: contents;
      }

      .menu nav {
        position: static;
        min-width: 0;
        padding: 0;
        border: 0;
        background: transparent;
      }

      ul {
        grid-auto-flow: column;
        gap: 0.25rem;
      }
    }
  }
</style>
