---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import LangSwitch from "./LangSwitch.astro";
import { useT, localizePath, stripLocale, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
  /** Brand and theme switch only (404). */
  reduced?: boolean;
}
const { locale, reduced = false } = Astro.props;
const t = useT(locale);
const path = stripLocale(Astro.url.pathname);

const links = [
  { path: "/download/", href: localizePath("/download/", locale), label: t.nav.download },
  { path: "/docs/", href: localizePath("/docs/", locale), label: t.nav.docs },
  { path: "/changelog/", href: localizePath("/changelog/", locale), label: t.nav.changelog },
  { path: "/llama-kt/", href: localizePath("/llama-kt/", locale), label: t.nav.llamaKt },
].filter((l) => isLive(l.path));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath("/", locale)}>
      <Mark size={30} />
      <span class="wordmark">{t.siteName}</span>
    </a>

    {/* DOM order is the visual order at both widths: the wide nav sits before the tools, the menu button after. */}
    {
      !reduced && (
        <nav class="nav-wide" aria-label={t.nav.label}>
          <ul>
            {links.map((l) => (
              <li><a class:list={{ mono: l.path === "/llama-kt/" }} href={l.href} aria-current={path === l.path ? "page" : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="tools">
      {
        !reduced && (
          <a class="icon-link" href="https://github.com/tensai-app" aria-label={t.nav.github}>
            <Icon name="github" size={22} />
          </a>
        )
      }
      <div class:list={["theme-slot", { always: reduced }]}>
        <ThemeSwitch locale={locale} />
      </div>
      {
        !reduced && (
          <div class="lang-slot">
            <LangSwitch locale={locale} path={path} />
          </div>
        )
      }
    </div>

    {
      !reduced && (
        <details class="menu">
          <summary aria-label={t.nav.menu}>
            <Icon name="menu" size={24} />
          </summary>
          <div class="panel">
            <nav aria-label={t.nav.label}>
              <ul>
                {links.map((l) => (
                  <li><a class:list={{ mono: l.path === "/llama-kt/" }} href={l.href} aria-current={path === l.path ? "page" : undefined}>{l.label}</a></li>
                ))}
              </ul>
            </nav>
            <div class="sheet-tools">
              <p class="sheet-label">{t.theme.label}</p>
              <ThemeSwitch locale={locale} variant="sheet" />
              <p class="sheet-label second">{t.lang.label}</p>
              <LangSwitch locale={locale} path={path} variant="sheet" />
            </div>
          </div>
        </details>
      )
    }
  </div>
</header>

<script>
  import "../scripts/menu";
</script>

<style>
  .site-header {
    height: 4rem;
    border-bottom: 1px solid var(--outline);
    background: var(--background);
  }

  /* One row at every width, before and after the web font loads: only the brand can shrink, the tools
     and the menu button have fixed widths. */
  .bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    column-gap: 0.25rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-width: 0;
    margin-inline-end: auto;
    padding-block: 0.5rem;
    color: var(--primary);
    text-decoration: none;
  }

  .brand :global(svg) {
    flex: none;
  }

  .wordmark {
    overflow: hidden;
    white-space: nowrap;
    color: var(--text);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Under 24rem the three theme options, GitHub and the menu button take 228px: the mark alone is the brand
     (the wordmark stays in the accessible name). */
  @media (max-width: 23.99rem) {
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      clip-path: inset(50%);
    }
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.7rem 1rem;
    line-height: 1.5rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  nav a.mono {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  nav a[aria-current="page"] {
    color: var(--primary);
  }

  /* Active marker: absolutely positioned, so active and inactive links have the same box. Menu: a bar on the
     start edge; wide nav (below): a 2px underline as wide as the text. */
  nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline-start: 0.4rem;
    inset-block: 1rem;
    width: 2px;
    border-radius: 2px;
    background: var(--primary);
  }

  nav a:hover {
    background: var(--surface-variant);
  }

  .nav-wide {
    display: none;
  }

  .menu {
    position: relative;
    flex: none;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary:hover {
    background: var(--surface-variant);
  }

  .menu .panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    width: min(20rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid var(--outline);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  /* The panel is a sheet: links on top, then theme and language in a block of their own. */
  .menu .panel ul {
    padding: 0.5rem;
  }

  .sheet-tools {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 20px 32px;
    border-top: 1px solid var(--outline);
  }

  .sheet-label {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  .sheet-label.second {
    margin-top: 8px;
  }

  .tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    text-decoration: none;
  }

  .icon-link:hover {
    background: var(--surface-variant);
  }

  /* Theme and language live in the mobile sheet below 45rem. */
  .theme-slot:not(.always),
  .lang-slot {
    display: none;
  }

  .theme-slot.always {
    display: flex;
    align-items: center;
  }

  .lang-slot {
    padding-inline-start: 12px;
  }

  /* Wide: the nav is inline and the language switch is in the bar; the menu button goes away. */
  @media (min-width: 45rem) {
    .nav-wide {
      display: block;
    }

    /* Baseline, not stretch: llama.kt is mono 14px next to 16px Figtree, their text must sit on one line. */
    .nav-wide ul {
      grid-auto-flow: column;
      align-items: baseline;
      gap: 28px;
    }

    /* 28px gap + 2px each side: 32px between the texts. The height (padding-block) keeps the 44px hit area. */
    .nav-wide a {
      padding-inline: 2px;
    }

    .nav-wide a[aria-current="page"]::after {
      inset-inline: 2px;
      inset-block: auto 0.55rem;
      width: auto;
      height: 2px;
    }

    .menu {
      display: none;
    }

    /* Mockup: the group is one more item of the nav row, gap 28px and margin-left -8px. The bar already has a 4px
       column gap and a flex gap is not shared with it, so 28 - 8 = 20px between the llama.kt box and the GitHub button. */
    .tools {
      margin-inline-start: 1rem;
    }

    .theme-slot:not(.always),
    .lang-slot {
      display: flex;
      align-items: center;
    }
  }
</style>
