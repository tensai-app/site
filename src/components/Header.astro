---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { useT, localizePath, stripLocale, locales, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
  /** Brand and theme switch only (404). */
  reduced?: boolean;
}
const { locale, reduced = false } = Astro.props;
const t = useT(locale);
const langNames: Record<Locale, string> = { en: "English", fr: "Français" };
const path = stripLocale(Astro.url.pathname);
const switchPath = /^\/404\/?$/.test(path) ? "/" : path;

const links = [
  { path: "/download/", href: localizePath("/download/", locale), label: t.nav.download },
  { path: "/docs/", href: localizePath("/docs/", locale), label: t.nav.docs },
  { path: "/changelog/", href: localizePath("/changelog/", locale), label: t.nav.changelog },
  { path: "/llama-kt/", href: localizePath("/llama-kt/", locale), label: t.nav.llamaKt },
].filter((l) => isLive(l.path));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath("/", locale)}>
      <Mark size={30} />
      <span class="wordmark">{t.siteName}</span>
    </a>

    {/* DOM order is the visual order at both widths: the wide nav sits before the tools, the menu button after. */}
    {
      !reduced && (
        <nav class="nav-wide" aria-label={t.nav.label}>
          <ul>
            {links.map((l) => (
              <li><a class:list={{ mono: l.path === "/llama-kt/" }} href={l.href} aria-current={path === l.path ? "page" : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="tools">
      {
        !reduced && (
          <a class="icon-link" href="https://github.com/tensai-app" aria-label={t.nav.github}>
            <Icon name="github" size={22} />
          </a>
        )
      }
      <ThemeSwitch locale={locale} />
      {
        !reduced && (
          <div class="lang lang-bar" role="group" aria-label={t.lang.label}>
            <Icon name="globe" size={18} />
            {locales.map((l) =>
              l === locale ? (
                <span class="lang-item current" aria-current="true" lang={l}>
                  <span aria-hidden="true">{l.toUpperCase()}</span>
                  <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
                </span>
              ) : (
                <a class="lang-item" href={localizePath(switchPath, l)} hreflang={l} lang={l}>
                  <span aria-hidden="true">{l.toUpperCase()}</span>
                  <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
                </a>
              ),
            )}
          </div>
        )
      }
    </div>

    {
      !reduced && (
        <details class="menu">
          <summary aria-label={t.nav.menu}>
            <Icon name="menu" size={24} />
          </summary>
          <nav aria-label={t.nav.label}>
            <ul>
              {links.map((l) => (
                <li><a class:list={{ mono: l.path === "/llama-kt/" }} href={l.href} aria-current={path === l.path ? "page" : undefined}>{l.label}</a></li>
              ))}
            </ul>
            <div class="lang" role="group" aria-label={t.lang.label}>
              <Icon name="globe" size={18} />
              {locales.map((l) =>
                l === locale ? (
                  <span class="lang-item current" aria-current="true" lang={l}>
                    <span aria-hidden="true">{l.toUpperCase()}</span>
                    <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
                  </span>
                ) : (
                  <a class="lang-item" href={localizePath(switchPath, l)} hreflang={l} lang={l}>
                    <span aria-hidden="true">{l.toUpperCase()}</span>
                    <span class="visually-hidden">{l.toUpperCase()} {langNames[l]}</span>
                  </a>
                ),
              )}
            </div>
          </nav>
        </details>
      )
    }
  </div>
</header>

<style>
  .site-header {
    height: 4rem;
    border-bottom: 1px solid var(--outline);
    background: var(--background);
  }

  /* One row at every width, before and after the web font loads: only the brand can shrink, the tools
     and the menu button have fixed widths. */
  .bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    column-gap: 0.25rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-width: 0;
    margin-inline-end: auto;
    padding-block: 0.5rem;
    color: var(--primary);
    text-decoration: none;
  }

  .brand :global(svg) {
    flex: none;
  }

  .wordmark {
    overflow: hidden;
    white-space: nowrap;
    color: var(--text);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Under 24rem the three theme options, GitHub and the menu button take 228px: the mark alone is the brand
     (the wordmark stays in the accessible name). */
  @media (max-width: 23.99rem) {
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      clip-path: inset(50%);
    }
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.7rem 1rem;
    line-height: 1.5rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  nav a.mono {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  nav a[aria-current="page"] {
    color: var(--primary);
  }

  /* Active marker: absolutely positioned, so active and inactive links have the same box. Menu: a bar on the
     start edge; wide nav (below): a 2px underline as wide as the text. */
  nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline-start: 0.4rem;
    inset-block: 1rem;
    width: 2px;
    border-radius: 2px;
    background: var(--primary);
  }

  nav a:hover {
    background: var(--surface-variant);
  }

  .nav-wide {
    display: none;
  }

  .menu {
    position: relative;
    flex: none;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary:hover {
    background: var(--surface-variant);
  }

  .menu nav {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 13rem;
    padding: 0.5rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .menu .lang {
    margin-top: 0.25rem;
    padding: 0.5rem 0.5rem 0;
    border-top: 1px solid var(--outline);
  }

  .tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--text);
    text-decoration: none;
  }

  .icon-link:hover,
  a.lang-item:hover {
    background: var(--surface-variant);
  }

  /* EN / FR: both shown, the current one is emphasised and is not a link. */
  .lang {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
  }

  .lang-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 3rem;
    padding: 0;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .lang-item.current {
    color: var(--text);
    font-weight: 700;
  }

  .lang.lang-bar {
    display: none;
  }

  /* Wide: the nav is inline and the language switch is in the bar; the menu button goes away. */
  @media (min-width: 45rem) {
    .nav-wide {
      display: block;
      margin-inline-end: 0.75rem;
    }

    /* Baseline, not stretch: llama.kt is mono 14px next to 16px Figtree, their text must sit on one line. */
    .nav-wide ul {
      grid-auto-flow: column;
      align-items: baseline;
      gap: 0.25rem;
    }

    .nav-wide a[aria-current="page"]::after {
      inset-inline: 1rem;
      inset-block: auto 0.55rem;
      width: auto;
      height: 2px;
    }

    .menu {
      display: none;
    }

    .lang.lang-bar {
      display: inline-flex;
    }

    .lang-bar :global(svg) {
      margin-inline-end: 0.15rem;
    }
  }
</style>
