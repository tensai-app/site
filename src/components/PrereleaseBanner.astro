---
import Icon from "./Icon.astro";
import { useT, localizePath, type Locale } from "../i18n";
import { isLive } from "../i18n/routes";

interface Props {
  locale: Locale;
  /** Locale-less path of the link target. */
  href?: string;
}
const { locale, href = "/changelog/" } = Astro.props;
const t = useT(locale).banner;
---

<div class="banner" role="note">
  <p>
    <span class="dot" aria-hidden="true"></span>
    <span>{t.text}</span>
  </p>
  {
    isLive(href) && (
      <a href={localizePath(href, locale)}>
        {t.link}
        <Icon name="arrow_right" size={16} />
      </a>
    )
  }
</div>

<style>
  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.25rem;
    padding: 0.875rem 1.25rem;
    border: 1px solid var(--outline);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  p {
    display: flex;
    flex: 1 1 16rem;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
