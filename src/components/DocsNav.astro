---
import Icon from "./Icon.astro";
import { docs, nav, routes, type Slug } from "../i18n/pages/docs";
import { privacy } from "../i18n/pages/privacy";
import { localizePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** The article being read. */
  slug: Slug;
}
const { locale, slug } = Astro.props;
const c = docs[locale];
const label = (s: Slug | "privacy") => (s === "privacy" ? privacy[locale].heading : c.articles[s].title);
const href = (s: Slug | "privacy") => localizePath(s === "privacy" ? "/privacy/" : routes[s], locale);
---

<ul class="docs-nav">
  {
    nav.map((e) =>
      "group" in e ? (
        <li>
          {/* Getting started is open everywhere, the other groups open on their own articles (as in the mockup). */}
          <details open={e.group === "start" || e.items.includes(slug)}>
            <summary>
              <span>{c.chrome.groups[e.group as "start" | "models"]}</span>
              <Icon name="expand_more" size={16} />
              <Icon name="chevron_right" size={16} />
            </summary>
            <ul>
              {e.items.map((s) => (
                <li>
                  <a href={href(s)} aria-current={s === slug ? "page" : undefined}>{label(s)}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ) : (
        <li>
          <a class="leaf" href={href(e.item)} aria-current={e.item === slug ? "page" : undefined}>
            <span>{label(e.item)}</span>
            <Icon name="chevron_right" size={16} />
          </a>
        </li>
      ),
    )
  }
</ul>

<style>
  .docs-nav,
  .docs-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  summary,
  .leaf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 9px 12px;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-decoration: none;
  }

  summary {
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .leaf {
    font-weight: 500;
  }

  .leaf:hover {
    background: var(--primary-08);
  }

  summary :global(svg),
  .leaf :global(svg) {
    flex: none;
    color: var(--text-secondary);
  }

  /* Open: the group shows expand_more. Closed: chevron_right. */
  summary :global(svg:last-child) {
    display: none;
  }

  details:not([open]) > summary :global(svg:nth-of-type(1)) {
    display: none;
  }

  details:not([open]) > summary :global(svg:last-child) {
    display: block;
  }

  details ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 0 6px;
    padding-inline-start: 12px;
  }

  details a {
    display: block;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.90625rem;
    line-height: 1.6;
    text-decoration: none;
  }

  details a:hover {
    background: var(--primary-08);
    color: var(--text);
  }

  a[aria-current="page"],
  details a[aria-current="page"] {
    background: var(--primary-12);
    color: var(--primary);
    font-weight: 600;
  }
</style>
