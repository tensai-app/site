{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/fr/index.html",
        "/download/index.html",
        "/fr/download/index.html",
        "/llama-kt/index.html",
        "/fr/llama-kt/index.html",
        "/privacy/index.html",
        "/fr/privacy/index.html",
        "/legal/index.html",
        "/fr/legal/index.html",
        "/404.html",
        "/fr/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "categories:performance": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "categories:best-practices": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "categories:seo": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "resource-summary:script:size": [
            "error",
            {
              "maxNumericValue": 102400
            }
          ],
          "matchingUrlPattern": "^(?!.*/404\\.html$)",
          "cumulative-layout-shift": [
            "error",
            {
              "maxNumericValue": 0.05
            }
          ]
        },
        {
          "categories:performance": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "categories:best-practices": [
            "error",
            {
              "minScore": 0.95
            }
          ],
          "resource-summary:script:size": [
            "error",
            {
              "maxNumericValue": 102400
            }
          ],
          "matchingUrlPattern": "/404\\.html$",
          "cumulative-layout-shift": [
            "error",
            {
              "maxNumericValue": 0.05
            }
          ]
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
