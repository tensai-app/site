{
	"name": "tensai-site",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "tensai.page", "custom_domain": true },
		{ "pattern": "www.tensai.page", "custom_domain": true }
	]
}
